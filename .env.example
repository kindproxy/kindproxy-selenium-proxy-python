# Copy this file's values into your shell environment.
# This example uses IP allowlisting, not HTTP username/password authentication.

PROXY_SERVER=gw.kindproxy.com:12200
TARGET_URL=https://example.com/
EXPECTED_TEXT=Example Domain

# Browser and driver paths on Ubuntu (adjust if installed elsewhere).
CHROME_BINARY=/usr/bin/google-chrome
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# Optional runtime settings.
HEADLESS=true
PAGE_LOAD_TIMEOUT=60
IP_CHECK_TIMEOUT=20
TARGET_WAIT_TIMEOUT=30
